# ToneForge environment configuration
# Copy to .env and fill in. NEVER commit .env.

# --- Office / add-in ---
NODE_ENV=development
PORT=3000
HTTPS_PORT=3001
DEV_CERT_PFX=

# --- LLM provider (provider-agnostic layer) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# --- Semantic review budgets ---
# The whole provider stage for one review, retries included. Keep this ABOVE
# OPENAI_TIMEOUT_MS: it bounds the stage that contains one or more requests, so a
# lower value cuts off an attempt the per-request deadline still allowed.
SEMANTIC_STAGE_TIMEOUT_MS=90000
# The most tokens one review may generate. A review is a bounded object, so an
# unbounded completion buys nothing but time. Raise it if a long selection is
# truncated, which surfaces as an unreadable response rather than a rejection.
SEMANTIC_REVIEW_MAX_TOKENS=3000

# --- Telemetry / privacy ---
TELEMETRY_DISABLED=1
ANALYTICS_ENDPOINT=

# --- Debugging ---
# Set to 1 to log what the consistency review sends and receives at each
# provider call site. Off by default; no overhead when unset.
DEBUG_CONSISTENCY=0