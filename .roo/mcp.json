{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": ""
      },
      "alwaysAllow": ["resolve-library-id", "query-docs"]
    },
    "microsoft-learn": {
      "type": "streamable-http",
      "url": "https://learn.microsoft.com/api/mcp",
      "alwaysAllow": [
        "microsoft_docs_search",
        "microsoft_docs_fetch",
        "microsoft_code_sample_search"
      ]
    },
    "sequentialthinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "alwaysAllow": ["sequentialthinking"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C://repos"],
      "alwaysAllow": [
        "list_directory",
        "list_allowed_directories",
        "read_file",
        "read_text_file",
        "read_media_file",
        "read_multiple_files"
      ]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "C://repos//ToneForge"],
      "alwaysAllow": [
        "git_status",
        "git_log",
        "git_diff",
        "git_show",
        "git_branch",
        "git_diff_staged",
        "git_diff_unstaged"
      ]
    }
  }
}
