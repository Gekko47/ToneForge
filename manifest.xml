<?xml version="1.0" encoding="UTF-8"?>
<!--
  ToneForge — XML add-in only manifest (fallback for platforms that do not
  support the unified manifest v1.30).

  This file mirrors manifest.json and must stay in sync. If you modify
  manifest.json, mirror those changes here as well.
-->
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xsi:type="TaskPaneApp">
  <Id>96df86d6-ce2f-42e9-8fba-916143aeeb5c</Id>
  <Version>1.0</Version>
  <ProviderName>Gekko47</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ToneForge" />
  <Description DefaultValue="ToneForge is a Word Web Add-in that learns an editable style profile from writing samples, runs deterministic micro-consistency checks, uses AI only where interpretation is required, and applies safe native Word revisions." />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/Gekko47/ToneForge/issues" />
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
                    xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="AddinCommands" MinVersion="1.1" />
        <bt:Set Name="ContextMenuApi" MinVersion="1.1" />
        <bt:Set Name="RibbonApi" MinVersion="1.1" />
        <!--
          SharedRuntime 1.1 is what makes the long-lifetime Runtimes entry
          below legal. Office.ribbon.requestUpdate and
          Office.contextMenu.requestUpdate are only reachable from a shared
          runtime, so a short-lived function file could never enable the
          semantic control at runtime.
        -->
        <bt:Set Name="SharedRuntime" MinVersion="1.1" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Document">
        <!--
          The schema-supported spelling of the shared runtime: a `Runtimes`
          element on the Host. It is the FIRST child, ahead of DesktopFormFactor,
          because the Host type's base sequence declares Runtimes (and then
          AllFormFactors) before the form factor that extends it. `lifetime="long"`
          is what makes it shared, and the resid must agree with the FunctionFile
          it replaces, so this points at the same commands page.
        -->
        <Runtimes>
          <Runtime resid="ToneForge.Commands.Url" lifetime="long" />
        </Runtimes>
        <DesktopFormFactor>
          <FunctionFile resid="ToneForge.Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="ToneForgeGroup">
                <Label resid="ToneForge.GroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="ToneForgeTaskpane">
                  <Label resid="ToneForge.TaskpaneLabel" />
                  <Supertip>
                    <Title resid="ToneForge.TaskpaneLabel" />
                    <Description resid="ToneForge.TaskpaneDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
            <OfficeTab id="ToneForge">
              <Group id="ToneForgeGovernanceGroup">
                <!--
                  The resource id is NOT the label text. Microsoft caps a `resid`
                  attribute and the corresponding resource `id` at 32 characters,
                  and an over-length one makes Word refuse the manifest outright:
                  the add-in fails to register and reports "This add-in is no
                  longer available". "ToneForge.DeterministicReviewGroupLabel" is
                  39 characters, so the label wording lives in DefaultValue only.
                  `npm run validate` enforces the 32-character limit.
                -->
                <Label resid="ToneForge.DetReviewGroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="ToneForgeScan">
                  <Label resid="ToneForge.ScanLabel" />
                  <Supertip>
                    <Title resid="ToneForge.ScanLabel" />
                    <Description resid="ToneForge.ScanDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="ToneForgeFindings">
                  <Label resid="ToneForge.FindingsLabel" />
                  <Supertip>
                    <Title resid="ToneForge.FindingsLabel" />
                    <Description resid="ToneForge.FindingsDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
              <Group id="ToneForgeAIReviewGroup">
                <Label resid="ToneForge.AIReviewGroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="ToneForgeReview">
                  <Label resid="ToneForge.ReviewLabel" />
                  <Supertip>
                    <Title resid="ToneForge.ReviewLabel" />
                    <Description resid="ToneForge.ReviewDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
              <!--
                The group and control ids below are the ones `syncSemanticRibbon`
                addresses at runtime. They must match `SEMANTIC_RIBBON_GROUP` and
                `SEMANTIC_RIBBON_CONTROL` in src/commands/ribbonState.ts exactly, or
                the enable request targets a control the host does not have and the
                button stays greyed out with nothing to explain why.
              -->
              <Group id="ToneForgeProfile">
                <Label resid="ToneForge.ProfileGroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="ToneForgeProfile">
                  <Label resid="ToneForge.ProfileLabel" />
                  <Supertip>
                    <Title resid="ToneForge.ProfileLabel" />
                    <Description resid="ToneForge.ProfileDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="ToneForgeGovernancePolicy">
                  <Label resid="ToneForge.GovernancePolicyLabel" />
                  <Supertip>
                    <Title resid="ToneForge.GovernancePolicyLabel" />
                    <Description resid="ToneForge.GovernancePolicyDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
                <!--
                  Disabled here and enabled only by `syncSemanticRibbon`. The rewrite
                  is meaningless without a semantic profile: the prompt sends the
                  profile, so with none there is nothing to send. `Enabled` follows
                  `Action` because that is the order the Button schema declares.
                -->
                <Control xsi:type="Button" id="ToneForgeSemanticControl">
                  <Label resid="ToneForge.SemanticLabel" />
                  <Supertip>
                    <Title resid="ToneForge.SemanticLabel" />
                    <Description resid="ToneForge.SemanticDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                  <Enabled>false</Enabled>
                </Control>
              </Group>
              <Group id="ToneForgeChangesGroup">
                <Label resid="ToneForge.ChangesGroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="ToneForgePendingChanges">
                  <Label resid="ToneForge.PendingChangesLabel" />
                  <Supertip>
                    <Title resid="ToneForge.PendingChangesLabel" />
                    <Description resid="ToneForge.PendingChangesDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="ToneForgeTroubleshooting">
                  <Label resid="ToneForge.TroubleshootingLabel" />
                  <Supertip>
                    <Title resid="ToneForge.TroubleshootingLabel" />
                    <Description resid="ToneForge.TroubleshootingDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <!--
            The context-menu entry is its own ExtensionPoint. Nesting
            `mso:officeMenu` inside PrimaryCommandSurface is Custom UI
            markup, which this schema does not allow, and it is why the
            context menu could be declared correctly and still never appear.
          -->
          <ExtensionPoint xsi:type="ContextMenu">
            <OfficeMenu id="ContextMenuText">
              <!--
                `xsi:type` is REQUIRED on Control (Button, Menu, or
                MobileButton), not optional. Omitting it makes Word reject the
                whole manifest at parse time — "Add-in manifest parsing
                encountered an unexpected child node" — so every control in the
                add-in disappears, not just this one. The context menu then
                looks like a context-menu problem and registers as "This add-in
                is no longer available", which is a manifest problem. Check
                %LOCALAPPDATA%\Temp\OfficeAddins.log.txt for the exact line.
              -->
              <Control xsi:type="Button" id="ToneForgeSemanticContextControl">
                <Label resid="ToneForge.SemanticLabel" />
                <Supertip>
                  <Title resid="ToneForge.SemanticLabel" />
                  <Description resid="ToneForge.SemanticDesc" />
                </Supertip>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Action xsi:type="ExecuteFunction">
                  <FunctionName>ToneForgeSemantic</FunctionName>
                </Action>
              </Control>
            </OfficeMenu>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="ToneForge.Commands.Url" DefaultValue="https://localhost:3000/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="ToneForge.GroupLabel" DefaultValue="ToneForge" />
        <bt:String id="ToneForge.TaskpaneLabel" DefaultValue="ToneForge task pane" />
        <bt:String id="ToneForge.TabLabel" DefaultValue="ToneForge" />
        <bt:String id="ToneForge.DetReviewGroupLabel" DefaultValue="Deterministic Review" />
        <bt:String id="ToneForge.AIReviewGroupLabel" DefaultValue="AI Review" />
        <bt:String id="ToneForge.ProfileGroupLabel" DefaultValue="Profile" />
        <bt:String id="ToneForge.ChangesGroupLabel" DefaultValue="Changes" />
        <bt:String id="ToneForge.ScanLabel" DefaultValue="Scan Now" />
        <bt:String id="ToneForge.FindingsLabel" DefaultValue="Findings" />
        <bt:String id="ToneForge.ReviewLabel" DefaultValue="Review for Consistency" />
        <bt:String id="ToneForge.ProfileLabel" DefaultValue="Style Profile" />
        <bt:String id="ToneForge.GovernancePolicyLabel" DefaultValue="Governance Policy" />
        <bt:String id="ToneForge.PendingChangesLabel" DefaultValue="Pending Changes" />
        <bt:String id="ToneForge.TroubleshootingLabel" DefaultValue="Troubleshooting" />
        <bt:String id="ToneForge.SemanticLabel" DefaultValue="Check Semantic Style" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ToneForge.TaskpaneDescription" DefaultValue="Learn a style from samples and check consistency across Word documents." />
        <bt:String id="ToneForge.ScanDescription" DefaultValue="Run the deterministic style checks against this document now and show the results." />
        <bt:String id="ToneForge.FindingsDescription" DefaultValue="Open the findings already recorded for this document." />
        <bt:String id="ToneForge.ReviewDesc" DefaultValue="Check whether different parts of this document disagree with each other. You choose when to run it, after seeing exactly what would be sent." />
        <bt:String id="ToneForge.ProfileDesc" DefaultValue="Open the deterministic style profile this document is checked against: typography, house style, and the measured metrics they came from." />
        <bt:String id="ToneForge.GovernancePolicyDesc" DefaultValue="Open the policy that decides which checks are mandatory, which are advisory, and which corrections ToneForge may apply without asking." />
        <bt:String id="ToneForge.PendingChangesDesc" DefaultValue="Open the proposed Word revisions waiting for your approval." />
        <bt:String id="ToneForge.TroubleshootingDesc" DefaultValue="Inspect this Word host's capabilities and the coverage of the last scan. These checks never change the document." />
        <bt:String id="ToneForge.SemanticDesc" DefaultValue="Ask for a rewrite of the selected text that matches your semantic style. Nothing is changed until you approve it on Deterministic Review." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
