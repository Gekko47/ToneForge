{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "id": "96df86d6-ce2f-42e9-8fba-916143aeeb5c",
  "version": "0.2.0",
  "developer": {
    "name": "Gekko47",
    "websiteUrl": "https://github.com/Gekko47/ToneForge",
    "privacyUrl": "https://github.com/Gekko47/ToneForge/blob/main/docs/privacy-security.md",
    "termsOfUseUrl": "https://github.com/Gekko47/ToneForge/blob/main/LICENSE"
  },
  "name": {
    "short": "ToneForge",
    "full": "ToneForge — style consistency for Word"
  },
  "description": {
    "short": "Learn a style from samples and check consistency across Word documents.",
    "full": "ToneForge is a Word Web Add-in that learns an editable style profile from writing samples, runs deterministic micro-consistency checks, uses AI only where interpretation is required, and applies safe native Word revisions."
  },
  "icons": {
    "outline": "assets/icon-32.png",
    "color": "assets/icon-80.png",
    "color32x32": "assets/icon-32.png"
  },
  "accentColor": "#2F6F6F",
  "validDomains": ["https://localhost:3000"],
  "extensions": [
    {
      "requirements": {
        "capabilities": [
          {
            "name": "WordApi",
            "minVersion": "1.1"
          }
        ],
        "scopes": ["document"],
        "formFactors": ["desktop"]
      },
      "ribbons": [
        {
          "contexts": ["default"],
          "tabs": [
            {
              "id": "ToneForge",
              "label": "ToneForge",
              "groups": [
                {
                  "id": "ToneForgeGovernance",
                  "label": "Governance",
                  "controls": [
                    {
                      "id": "ToneForgeScanControl",
                      "type": "button",
                      "label": "Scan Now",
                      "actionId": "ToneForgeScan",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Scan Now",
                        "description": "Run the deterministic style checks against this document and open the results."
                      }
                    },
                    {
                      "id": "ToneForgeFindingsControl",
                      "type": "button",
                      "label": "Findings",
                      "actionId": "ToneForgeFindings",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Findings",
                        "description": "Open the findings already recorded for this document."
                      }
                    }
                  ]
                },
                {
                  "id": "ToneForgeAIReview",
                  "label": "AI Review",
                  "controls": [
                    {
                      "id": "ToneForgeReviewSelectionControl",
                      "type": "button",
                      "label": "Review Selection",
                      "actionId": "ToneForgeReviewSelection",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Review Selection",
                        "description": "Start a spot review of the text you have selected in Word."
                      }
                    },
                    {
                      "id": "ToneForgeReviewDocumentControl",
                      "type": "button",
                      "label": "Review Document",
                      "actionId": "ToneForgeReviewDocument",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Review Document",
                        "description": "Start a whole-document review after you confirm what leaves the add-in."
                      }
                    }
                  ]
                },
                {
                  "id": "ToneForgeProfile",
                  "label": "Profile",
                  "controls": [
                    {
                      "id": "ToneForgeActiveProfileControl",
                      "type": "button",
                      "label": "Active Profile",
                      "actionId": "ToneForgeActiveProfile",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Active Profile",
                        "description": "Open the style profile this document is currently checked against."
                      }
                    },
                    {
                      "id": "ToneForgeEditProfileControl",
                      "type": "button",
                      "label": "Edit Profile",
                      "actionId": "ToneForgeEditProfile",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Edit Profile",
                        "description": "Open the style profile settings to adjust what the add-in enforces."
                      }
                    }
                  ]
                },
                {
                  "id": "ToneForgeChanges",
                  "label": "Changes",
                  "controls": [
                    {
                      "id": "ToneForgePendingChangesControl",
                      "type": "button",
                      "label": "Pending Changes",
                      "actionId": "ToneForgePendingChanges",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Pending Changes",
                        "description": "Open the proposed Word revisions waiting for your approval."
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "runtimes": [
        {
          "id": "taskpane",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ToneForgeTaskpane",
              "type": "openPage",
              "displayName": "ToneForge"
            }
          ]
        },
        {
          "id": "CommandsRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/commands.html"
          },
          "lifetime": "short",
          "actions": [
            { "id": "ToneForgeScan", "type": "executeFunction" },
            { "id": "ToneForgeFindings", "type": "executeFunction" },
            { "id": "ToneForgeReviewSelection", "type": "executeFunction" },
            { "id": "ToneForgeReviewDocument", "type": "executeFunction" },
            { "id": "ToneForgeActiveProfile", "type": "executeFunction" },
            { "id": "ToneForgeEditProfile", "type": "executeFunction" },
            { "id": "ToneForgePendingChanges", "type": "executeFunction" }
          ]
        }
      ]
    }
  ]
}
