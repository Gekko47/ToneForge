{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "id": "96df86d6-ce2f-42e9-8fba-916143aeeb5c",
  "version": "0.2.0",
  "developer": {
    "name": "Gekko47",
    "websiteUrl": "https://github.com/Gekko47/ToneForge",
    "privacyUrl": "https://github.com/Gekko47/ToneForge/blob/main/docs/privacy-security.md",
    "termsOfUseUrl": "https://github.com/Gekko47/ToneForge/blob/main/LICENSE"
  },
  "name": {
    "short": "ToneForge",
    "full": "ToneForge — style consistency for Word"
  },
  "description": {
    "short": "Learn a style from samples and check consistency across Word documents.",
    "full": "ToneForge is a Word Web Add-in that learns an editable style profile from writing samples, runs deterministic micro-consistency checks, uses AI only where interpretation is required, and applies safe native Word revisions."
  },
  "icons": {
    "outline": "assets/icon-32.png",
    "color": "assets/icon-80.png",
    "color32x32": "assets/icon-32.png"
  },
  "accentColor": "#2F6F6F",
  "validDomains": ["https://localhost:3000"],
  "extensions": [
    {
      "requirements": {
        "capabilities": [
          {
            "name": "WordApi",
            "minVersion": "1.1"
          },
          {
            "name": "SharedRuntime",
            "minVersion": "1.1"
          },
          {
            "name": "RibbonApi",
            "minVersion": "1.1"
          }
        ],
        "scopes": ["document"],
        "formFactors": ["desktop"]
      },
      "ribbons": [
        {
          "contexts": ["default"],
          "tabs": [
            {
              "id": "ToneForge",
              "label": "ToneForge",
              "groups": [
                {
                  "id": "ToneForgeGovernance",
                  "label": "Deterministic Review",
                  "controls": [
                    {
                      "id": "ToneForgeScanControl",
                      "type": "button",
                      "label": "Scan Now",
                      "actionId": "ToneForgeScan",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Scan Now",
                        "description": "Run the deterministic style checks against this document now and show the results."
                      }
                    },
                    {
                      "id": "ToneForgeFindingsControl",
                      "type": "button",
                      "label": "Findings",
                      "actionId": "ToneForgeFindings",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Findings",
                        "description": "Open the findings already recorded for this document."
                      }
                    }
                  ]
                },
                {
                  "id": "ToneForgeAIReview",
                  "label": "AI Review",
                  "controls": [
                    {
                      "id": "ToneForgeReviewControl",
                      "type": "button",
                      "label": "Review for Consistency",
                      "actionId": "ToneForgeReview",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Review for Consistency",
                        "description": "Check whether different parts of this document disagree with each other. You choose when to run it, after seeing exactly what would be sent."
                      }
                    }
                  ]
                },
                {
                  "id": "ToneForgeProfileGroup",
                  "label": "Profile",
                  "controls": [
                    {
                      "id": "ToneForgeProfileControl",
                      "type": "button",
                      "label": "Style Profile",
                      "actionId": "ToneForgeProfile",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Style Profile",
                        "description": "Open the deterministic style profile this document is checked against: typography, house style, and the measured metrics they came from."
                      }
                    },
                    {
                      "id": "ToneForgeGovernancePolicyControl",
                      "type": "button",
                      "label": "Governance Policy",
                      "actionId": "ToneForgeGovernancePolicy",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Governance Policy",
                        "description": "Open the policy that decides which checks are mandatory, which are advisory, and which corrections ToneForge may apply without asking."
                      }
                    },
                    {
                      "id": "ToneForgeSemanticControl",
                      "type": "button",
                      "label": "Semantic Review",
                      "actionId": "ToneForgeSemantic",
                      "enabled": false,
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Semantic Review",
                        "description": "Review the selected text against your semantic style. Nothing is changed until you read the review and approve a revision on the Semantic Review page. Disabled until a semantic style profile exists."
                      }
                    }
                  ]
                },
                {
                  "id": "ToneForgeChanges",
                  "label": "Changes",
                  "controls": [
                    {
                      "id": "ToneForgePendingChangesControl",
                      "type": "button",
                      "label": "Pending Changes",
                      "actionId": "ToneForgePendingChanges",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Pending Changes",
                        "description": "Open the proposed Word revisions waiting for your approval."
                      }
                    },
                    {
                      "id": "ToneForgeTroubleshootingControl",
                      "type": "button",
                      "label": "Troubleshooting",
                      "actionId": "ToneForgeTroubleshooting",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Troubleshooting",
                        "description": "Inspect this Word host's capabilities and the coverage of the last scan. These checks never change the document."
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "contextMenus": [
        {
          "requirements": {
            "capabilities": [
              {
                "name": "ContextMenuApi",
                "minVersion": "1.1"
              }
            ]
          },
          "menus": [
            {
              "entryPoint": "text",
              "controls": [
                {
                  "id": "ToneForgeSemanticContextControl",
                  "type": "button",
                  "label": "Semantic Review",
                  "actionId": "ToneForgeSemanticTaskpane",
                  "icons": [
                    { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                    { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                    { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                  ],
                  "supertip": {
                    "title": "Semantic Review",
                    "description": "Review this selection against your semantic style. Nothing is changed until you read the review and approve a revision on the Semantic Review page."
                  }
                }
              ]
            }
          ]
        }
      ],
      "runtimes": [
        {
          "id": "taskpane",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ToneForgeTaskpane",
              "type": "openPage",
              "displayName": "ToneForge"
            }
          ]
        },
        {
          "id": "taskpaneSemantic",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/semantic.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ToneForgeSemanticTaskpane",
              "type": "openPage",
              "displayName": "ToneForge Semantic Review"
            }
          ]
        },
        {
          "id": "CommandsRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/commands.html"
          },
          "lifetime": "long",
          "actions": [
            { "id": "ToneForgeScan", "type": "executeFunction" },
            { "id": "ToneForgeFindings", "type": "executeFunction" },
            { "id": "ToneForgeReview", "type": "executeFunction" },
            { "id": "ToneForgeProfile", "type": "executeFunction" },
            { "id": "ToneForgeGovernancePolicy", "type": "executeFunction" },
            { "id": "ToneForgePendingChanges", "type": "executeFunction" },
            { "id": "ToneForgeTroubleshooting", "type": "executeFunction" },
            { "id": "ToneForgeSemantic", "type": "executeFunction" }
          ]
        }
      ]
    }
  ]
}
