{
  "name": "toneforge",
  "version": "0.1.0",
  "description": "ToneForge — Word Web Add-in for style learning, consistency checks, and deterministic formatting.",
  "author": "Gekko47",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "webpack serve --config webpack.dev.js --host 127.0.0.1 --port 3000",
    "build": "webpack --config webpack.prod.js",
    "build:dev": "webpack --config webpack.dev.js --mode development",
    "clean": "rm -rf dist build coverage .tsbuildinfo",
    "sideload": "npx office-addin-debugging start manifest.json",
    "stop": "npx office-addin-debugging stop manifest.json",
    "validate": "node scripts/validate-manifest.mjs",
    "skills:validate": "node scripts/validate-skills.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test && npm run build && npm run validate",
    "stage:verify": "node scripts/stage-verify.mjs",
    "prepare": "husky",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@fluentui/react": "^8.120.0",
    "lodash-es": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.1",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "office-addin-dev-certs": "^3.0.0",
    "office-addin-debugging": "^7.0.0",
    "office-addin-manifest": "^3.0.0",
    "prettier": "^3.3.4",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-merge": "^6.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
