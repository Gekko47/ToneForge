# Normalize line endings in the repository so that archived and checked-out
# trees are byte-identical to the committed content.
#
# Without this, `core.autocrlf=true` on Windows makes `git archive` (used by
# `npm run clean-install:check`) emit CRLF, which fails `prettier --check`
# because `.prettierrc.json` sets `endOfLine: "lf"`. CI on Linux passed only
# because the setting does not apply there.
* text=auto eol=lf

# Windows and Office require CRLF for these.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Generated and vendored assets are not normalized.
package-lock.json -text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
